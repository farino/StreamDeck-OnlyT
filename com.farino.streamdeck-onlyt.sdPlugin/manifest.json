{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.farino.streamdeck-onlyt",
	"Name": "Meeting Timer for OnlyT",
	"Version": "1.3.0.0",
	"Author": "Farino",
	"URL": "https://github.com/farino/StreamDeck-OnlyT/",
	"Description": "Control the OnlyT meeting timer from your Stream Deck. Start, stop, and monitor countdown timers with live colour-coded status. Third-party plugin - not affiliated with OnlyT.",
	"Category": "Meeting Timer for OnlyT",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"Actions": [
		{
			"Name": "Timer Control",
			"UUID": "com.farino.streamdeck-onlyt.timer-control",
			"Icon": "imgs/actions/timer/icon",
			"Tooltip": "Start and stop OnlyT meeting timers. Shows countdown, talk name, and colour-coded status.",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/timer-settings.html",
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle",
					"Title": ""
				}
			]
		},
		{
			"Name": "Start & Stop Only",
			"UUID": "com.farino.streamdeck-onlyt.start-stop",
			"Icon": "imgs/actions/start-stop/icon",
			"Tooltip": "Start or stop the current OnlyT talk. Shows a play or stop glyph only - no countdown.",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/start-stop-settings.html",
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle",
					"Title": ""
				}
			]
		},
		{
			"Name": "Item Titles Only",
			"UUID": "com.farino.streamdeck-onlyt.item-titles",
			"Icon": "imgs/actions/item-titles/icon",
			"Tooltip": "Display the current OnlyT talk name in large white text. Read-only - pressing does nothing.",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/item-titles-settings.html",
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle",
					"Title": ""
				}
			]
		},
		{
			"Name": "Add Minute",
			"UUID": "com.farino.streamdeck-onlyt.add-minute",
			"Icon": "imgs/actions/add-minute/icon",
			"Tooltip": "Add one minute to the current OnlyT talk duration.",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/add-minute-settings.html",
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle",
					"Title": ""
				}
			]
		},
		{
			"Name": "Subtract Minute",
			"UUID": "com.farino.streamdeck-onlyt.subtract-minute",
			"Icon": "imgs/actions/subtract-minute/icon",
			"Tooltip": "Subtract one minute from the current OnlyT talk duration.",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/subtract-minute-settings.html",
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle",
					"Title": ""
				}
			]
		},
		{
			"Name": "JW Study",
			"UUID": "com.farino.streamdeck-onlyt.jw-study",
			"Icon": "imgs/actions/timer/icon",
			"Tooltip": "Bring JW Library to the foreground and navigate to Personal Study.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle",
					"Title": ""
				}
			]
		},
		{
			"Name": "JW Meetings",
			"UUID": "com.farino.streamdeck-onlyt.jw-meetings",
			"Icon": "imgs/actions/timer/icon",
			"Tooltip": "Bring JW Library to the foreground and navigate to Meetings.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle",
					"Title": ""
				}
			]
		}
	]
}